@using Kazo.Irc.Text
@* The text of a message: its IRC styles as CSS classes, its web addresses as links that open in the
   OS Browser. Every piece is rendered as text (Razor encodes it): nothing from the network becomes
   HTML. A link has no href on purpose: a middle click or "open in a new tab" would otherwise send
   the address to the host browser instead of the OS Browser; the title shows where it goes. *@
@foreach (var segment in Segments)
{
    if (segment.Link is { } link)
    {
        <a class="message-link" role="link" tabindex="0" title="@link.AbsoluteUri"
           @onclick="() => OpenAsync(link)" @onkeydown="e => OnKeyDownAsync(e, link)">@foreach (var run in segment.Runs)
            {
                <span class="@ClassOf(run.Style)">@run.Text</span>
            }</a>
    }
    else
    {
        foreach (var run in segment.Runs)
        {
            if (run.Style.IsPlain)
            {
                @run.Text
            }
            else
            {
                <span class="@ClassOf(run.Style)">@run.Text</span>
            }
        }
    }
}
